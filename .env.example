# Environment variables example
# Copy to .env for local development

VITE_API_BASE_URL=https://raw.githubusercontent.com/LITUATUI/M3UPT/main/M3U
VITE_APP_TITLE=Portugal IPTV
VITE_APP_DESCRIPTION=Portugal IPTV player with channel list and video player
VITE_CACHE_TTL=300000  # 5 minutes in milliseconds
VITE_REFRESH_INTERVAL=300000  # 5 minutes in milliseconds
VITE_ONLINE_CHECK_INTERVAL=30000  # 30 seconds in milliseconds